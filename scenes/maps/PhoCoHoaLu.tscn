[node name="NPC_LangGia" parent="NPCs" instance=ExtResource("7_npc")]
position = Vector2(420, 584)
npc_name = "Cụ Lang Già"
lines = PackedStringArray("Chào cháu, người trẻ. Ta là bô lão của Phố Cổ Hoa Lư.", "Ngày xưa nơi đây từng là kinh đô, giờ là chốn yên bình bên sông.", "Muốn tìm gỗ và khoáng thì ra khu Rừng ở cổng phía đông kia.")

[node name="NPC_NguoiBanHang" parent="NPCs" instance=ExtResource("7_npc")]
position = Vector2(760, 584)
npc_name = "Chị Bán Hàng"
lines = PackedStringArray("Ghé xem hàng nào! Đèn lồng, vải vóc, đủ cả.", "Tiếc là hôm nay ta chưa mở sạp buôn bán... hẹn cháu dịp sau nhé!")

[node name="NPC_NguDan" parent="NPCs" instance=ExtResource("7_npc")]
position = Vector2(1180, 584)
npc_name = "Bác Ngư Dân"
lines = PackedStringArray("Con sông này lắm cá lắm.", "Sáng sớm sương giăng trên cầu đá, đẹp không nói nên lời.", "Cẩn thận thú dữ trong rừng nghe cháu.")

[node name="NPC_TreCon" parent="NPCs" instance=ExtResource("7_npc")]
position = Vector2(1560, 584)
npc_name = "Cu Tí"
lines = PackedStringArray("Anh/chị chơi trốn tìm với em không?", "Hi hi, em biết chỗ có nhiều đom đóm lắm!")

[node name="NPC_ThayDo" parent="NPCs" instance=ExtResource("7_npc")]
position = Vector2(1960, 584)
npc_name = "Thầy Đồ"
lines = PackedStringArray("Chữ nghĩa là gốc rễ của con người.", "Chăm chỉ rèn luyện, ắt có ngày thành tài.", "Ta chúc cháu thượng lộ bình an trên hành trình khám phá.")

